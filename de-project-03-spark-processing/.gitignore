cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Local data
data/raw/
data/processed/

# Generated output
output/
*.log

# Spark
spark-warehouse/
metastore_db/
derby.log

# OS / editor
.DS_Store
.vscode/
.idea/
EOF
